# =====================================================================================================================
# AnyLog node environment variables
# Every $VARIABLE read by main.al and set_params.al (active code only).
# Values shown are the defaults the scripts fall back to; empty = not set (script skips it or auto-derives it).
# Variable names match exactly what the scripts read, including known typos (flagged with NOTE).
# =====================================================================================================================


#==== required ====
# generic | master | operator | query | publisher | master-operator | master-publisher
# (publisher is not supported on EdgeLake)
NODE_TYPE=generic
# Required - script exits if empty
LICENSE_KEY=""


COMPANY_NAME=Acme



#==== debug (main.al) ====
# Enable exception traceback (true/false)
ENABLE_TRACEBACK=false
# Trace level 1-3 (all currently map to `trace level = 1`)
TRACE_LEVEL=""
# Hide blockchain policy (ignored for operator nodes)
IS_HIDDEN=false
# Disable the AnyLog CLI
DISABLE_CLI=false


#==== directories (main.al) ====
# AnyLog root path
ANYLOG_PATH=/app
# Fallback root path, only used when ANYLOG_PATH is not set
EDGELAKE_PATH=""
# Default: !anylog_path/deployment-scripts
LOCAL_SCRIPTS=""
# Default: !local_scripts/test
TEST_DIR=""





#==== general / location ====
# If not set, pulled from https://ipinfo.io/json (fallback: 0.0, 0.0 / Unknown)
LOCATION=""
COUNTRY=""
STATE=""
CITY=""
BRANCH=""
DEPT=""


#==== networking ====
# Ports default by node type:
#   generic 32548/32549/32550 | master 32048/32049/- | operator 32148/32149/32150
#   query 32348/32349/-       | publisher 32248/32249/32250
ANYLOG_SERVER_PORT=""
ANYLOG_REST_PORT=""
ANYLOG_BROKER_PORT=""

TCP_BIND=true
TCP_THREADS=6
REST_BIND=false
REST_THREADS=6
# Seconds; 0 = continuous
REST_TIMEOUT=30
BROKER_BIND=false
BROKER_THREADS=6

# NIC used to resolve internal IP (ex. eth0)
NIC_TYPE=""
# Only used when NIC_TYPE is not set
OVERLAY_IP=""
ENABLE_DNS=false
EXTERNAL_DNS=""
# Full DNS name; if empty and DNS_DOMAIN is set -> !hostname.DNS_DOMAIN
DNS=""
DNS_DOMAIN=""
# Default: <node_type>-<company_name>-configs
CONFIG_NAME=""


#==== blockchain ====
# Master TCP ip:port. Values starting with 127.0.0.1 are ignored and auto-derived (<ip>:32048)
LEDGER_CONN=""
BLOCKCHAIN_SYNC=30 seconds
# master | optimism
BLOCKCHAIN_SOURCE=master
# NOTE: script reads $DESTINATION, not $BLOCKCHAIN_DESTINATION
DESTINATION=file

#--- Optimism (only used when BLOCKCHAIN_SOURCE != master) ---
# Script has built-in defaults for PROVIDER, keys and CHAIN_ID (11155420)
PROVIDER=""
BLOCKCHAIN_PUBLIC_KEY=""
BLOCKCHAIN_PRIVATE_KEY=""
CHAIN_ID=""
CONTRACT=""


#==== authentication (AnyLog only, ignored on EdgeLake) ====
ENABLE_AUTH=false
NODE_PASSWORD=""


#==== sql database ====
# sqlite | psql
DB_TYPE=sqlite
DB_USER=""
DB_PASSWD=""
DB_IP=""
DB_PORT=""
AUTOCOMMIT=true
# Default: company name
DEFAULT_DBMS=""

#--- System Query ---
# Always enabled on query nodes
SYSTEM_QUERY=false
# sqlite | psql
SYSTEM_QUERY_DB=sqlite
# In-memory SQLite for system_query
MEMORY=true

#--- MCP ---
ENABLE_MCP=false


#==== blob storage (nosql) ====
BLOBS_STORAGE=false
# Treated as true/false (forced true when BLOBS_STORAGE=false)
BLOBS_FOLDER=""
BLOBS_COMPRESS=true
BLOBS_REUSE=true
# mongo | s3 | akave | minio
BLOB_STORAGE_TYPE=""
BLOB_STORAGE_IP=""
BLOB_STORAGE_PORT=""
BLOB_STORAGE_USER=""
BLOB_STORAGE_PASSWORD=""

#--- Object Store ---
BUCKET_GROUP=""
BUCKET_ID=""
BUCKET_REGION=""
BUCKET_ACCESS_KEY=""
# NOTE: script reads $BUCKET_SECRETE_KEY (typo)
BUCKET_SECRETE_KEY=""


#==== operator ====
# Operator ID (int) - autogenerated if not set
MEMBER=""
DISABLE_PARTITIONS=false
# Default: * (all tables)
TABLE_NAME=""
PARTITION_COLUMN=insert_timestamp
PARTITION_INTERVAL=14 days
PARTITION_KEEP=3
PARTITION_SYNC=1 day
# sqlite | psql - default: DB_TYPE
ALMGM_DB=""

#--- HA ---
# NOTE: default is HA enabled (disable_ha=false)
DISABLE_HA=false
# Days back to sync (int -> -<n>d); script default -30d
START_DATE=30


#==== video streaming ====
ENABLE_VIDEO_STREAMING=false
ENABLE_DETECTIONS=false
VIDEO_URL=""
VIDEO_PORT=32800
VIDEO_NAME=fstream
YOLO_MODEL_PORT=5001
# Default: !anylog_path/AnyLog-Network/external_lib/frame_modeling
VIDEO_GRPC_DIR=""


#==== mqtt ====
ENABLE_MQTT=false
MQTT_BROKER=172.104.228.251
MQTT_PORT=1883
MQTT_USER=anyloguser
MQTT_PASSWD=mqtt4AnyLog!
MQTT_LOG=false

MSG_TOPIC=rand-data
# NOTE: only used when DEFAULT_DBMS is empty
MSG_DBMS=bring [dbms]
MSG_TABLE=bring [table]
MSG_TIMESTAMP_COLUMN=bring [timestamp]
MSG_VALUE_COLUMN=bring [value]
MSG_VALUE_COLUMN_TYPE=float


#==== monitoring ====
# NOTE: script defaults these to true; only an explicit false disables them
MONITORING_NODE=false
NODE_MONITORING=true
SYSLOG_MONITORING=true
DOCKER_MONITORING=true
# NOTE: currently has no effect - false sets store_monitoring=true (line 375)
STORE_MONITORING=true
# Default: blockchain get operator bring.last
STORE_MONITORING_DEST=""
# Default: blockchain get query bring.ip_port
VIEW_MONITORING_DEST=""
# sqlite | psql - default: DB_TYPE
MONITORING_DB=""
MONITORING_FREQUENCY=30 seconds
# Seconds
DOCKER_FREQUENCY=10


#==== opc-ua ====
ENABLE_OPCUA=false
OPCUA_URL=""
OPCUA_NODE=""
OPCUA_NAME=""
OPCUA_USERNAME=""
OPCUA_PASSWORD=""
OPCUA_FREQUENCY=5


#==== other settings ====
DEPLOY_LOCAL_SCRIPT=false
COMPRESS_FILE=true
WRITE_IMMEDIATE=true
THRESHOLD_TIME=60 seconds
THRESHOLD_VOLUME=10KB
OPERATOR_THREADS=3
QUERY_POOL=6
OPERATOR_HELPERS=0
ARCHIVE=true
ARCHIVE_SQL=false
# Days
ARCHIVE_DELETE=30


#==== commented out in set_params.al (not currently read) ====
# AGGREGATION_POLICY=""
# ENABLE_AGGREGATIONS=false
# AGGREGATIONS_DBMS=""
# AGGREGATIONS_TABLE=*
# AGGREGATIONS_INTERVALS=10
# AGGREGATIONS_TIME=1 minute
# AGGREGATION_TIME_COLUMN=insert_timestamp
# AGGREGATION_VALUE_COLUMN=value
# INGEST_RAW_DATA=true
# INGEST_AGGREGATIONS=false
# ENABLE_ENCODING=false
# ENCODING_TOLERANCE=""
# ENCODING_TYPE=bounds
# DBMS_FILE_LOCATION=file_name[0]
# TABLE_FILE_LOCATION=file_name[1]
# USERNAME=""
# USER_PASSWORD=""
# NOSQL_TYPE=""