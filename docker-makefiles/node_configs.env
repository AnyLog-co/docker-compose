#==== Required params ====

# Configuration based deployment node deployment type
# Node Types:
#   generic: sandbox with only network configured
#   master: "blockchain" emulator
#   operator: agent dedicated to storing data
#   query: agent dedicated to querying data (enable system_query logical database)
#   publisher: agent used to distribute data
#   master-operator: a combination of master and operator on a single agent
#   master-publisher: a combination of master and publisher on a single agent
# (publisher is not supported on EdgeLake)
NODE_TYPE=generic

# AnyLog License Key
LICENSE_KEY=""

# Master TCP ip:port. Values starting with 127.0.0.1 are ignored and auto-derived (<ip>:32048)
LEDGER_CONN=""

#==== Docker params (for our shell scripts / not needed for orchestration tools) ====

# Container image, deployment type
# -> prod: run AnyLog instance
# -> bash: run shell interface with AnyLog installed and params set
INIT_TYPE=bash

# AnyLog image
IMAGE=anylogco/anylog-network

# Github repo to use for configuring / deploying node
# The path can either be a Github URL and then the code will automatically clone
# the repo if needed OR a local path for deployment-scripts and then use that instead of cloning into the repositroy
# Branch associated with git repo
DEPLOYMENTS_REPO="https://github.com/AnyLog-co/deployment-scripts"
DEPLOYMENTS_BRANCH="os-dev"

# ---- Host filesystem mounts ----
# Mounts host directories into the container for system-level monitoring and diagnostics.
# Leave empty to disable the mount (e.g. HOST_PROC="")

# specify the docker socket - to be used when deploying docker monitoring
DOCKER_SOCKET=""

# /proc — exposes host process and kernel information; used for monitoring CPU, memory, and
#          system metrics from inside the container
HOST_PROC="/proc"

# / — mounts the entire host root filesystem read-only; used for disk usage reporting
#     and host-level file inspection. High security surface — disable if not needed.
HOST_ROOT="/"

# /sys — exposes kernel hardware and driver information; used for cgroup, disk, and
#        device-level metrics. Optional — disable if not needed.
HOST_SYS="/sys"

# Local folders to mount inside the AnyLog container.
#
# Examples:
#   No volumes:
#     USER_VOLUMES=""
#
#   Single volume:
#     USER_VOLUMES="/home/user/grpc-scripts"
#
#   Multiple volumes (space-separated):
#     USER_VOLUMES="/home/user/grpc-scripts /home/user/local-deployments"
#
# Notes:
#   - Use absolute paths only
#   - Paths are mounted automatically under /app/<folder-name>
#
# Example:
#   /home/user/grpc-scripts -> /app/grpc-scripts
#
USER_VOLUMES=""

# Controls the Docker network mode used in the generated compose file.
# Note: This sets how the container connects to the host network — it does NOT
#       change AnyLog's internal network configuration (ports, broker, etc.).
# Leave empty to auto-detect: host mode on Linux/WSL, port-mapped on Windows/macOS.
#
# Options:
#   <empty>        — auto-detect based on OS (recommended)
#   network        — force network_mode: host (Linux/WSL only)
#   ports          — force port-mapped mode (Windows, macOS, or Linux)
#   <custom-name>  — use a pre-existing external network (external: true)
#                    Docs: https://docs.docker.com/reference/cli/docker/network/create/
#
# Custom Network Example:
#   An overlay network allows AnyLog nodes deployed on different physical machines
#   to communicate as if they were on the same LAN — without exposing ports to the host.
#
#   Step 1 — Create the network once on the Swarm manager (or any Docker host):
#     docker network create --scope=swarm --attachable -d overlay anylog-net
#
#   Step 2 — Set the network name here:
#     NETWORK_TYPE=anylog-net
#
#   Each AnyLog node on any machine in the Swarm that uses NETWORK_TYPE=anylog-net
#   will be reachable by container name across hosts, e.g. my-node:32048
NETWORK_TYPE=""

# Auto-generated container name (used as Docker container_name).
# If NODE_NAME is not set, this is generated as hostname-nodetype-uid.
# If NODE_NAME is set, this mirrors it for consistency.
CONTAINER_NAME=""

#----- Debug Configs ----
# Enable a container packed with network troubleshooting tools (tcpdump, dig, curl, iperf, nmap, etc) that's shared with
# the AnyLog container network namespace, so you can debug its networking without installing anything in it or on the
# host.
DEBUG=false

# Script execution debugging - shows each command as the deployment scripts run it
#   false       - off
#   true        - print each line as it executes
SCRIPT_DEBUG=false

#=================================================== AnyLog Configs ===================================================#